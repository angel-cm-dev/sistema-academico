# Copia este archivo como .env y reemplaza los valores. NUNCA subas tu .env al repositorio.

# --- PostgreSQL ---
POSTGRES_DB=sistema_academico
POSTGRES_USER=academico
POSTGRES_PASSWORD=cambia-esta-clave-local

# --- API ---
# Clave para firmar los JWT (HMAC-SHA256). Mínimo 32 caracteres, aleatoria en producción.
# Puedes generar una con:  openssl rand -base64 48
JWT_KEY=reemplaza-por-una-clave-aleatoria-de-al-menos-32-caracteres
JWT_EXPIRATION_MINUTES=120
# Carga datos ficticios de demostración la primera vez (true/false).
SEED_DEMO=true

# --- Política de mora de pensiones ---
MORA_TASA_DIARIA=0.001
MORA_DIAS_GRACIA=3
MORA_TOPE_PORCENTAJE=0.10

# --- Puertos publicados en tu máquina ---
API_PORT=5080
WEB_PORT=8080
