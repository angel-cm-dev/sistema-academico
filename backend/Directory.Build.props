<Project>
  <!--
    Propiedades comunes a todos los proyectos de la solución.
    Centralizarlas evita que cada .csproj declare su propio TargetFramework
    y garantiza que todas las capas compilen con las mismas reglas.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Documentación XML para que OpenAPI tome los comentarios de los endpoints. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
