{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=sistema_academico;Username=postgres;Password=cambia-esta-clave"
  },
  "Database": {
    "Provider": "Postgres",
    "Seed": true
  },
  "Jwt": {
    "Issuer": "sistema-academico",
    "Audience": "sistema-academico-web",
    "Key": "",
    "ExpirationMinutes": 120
  },
  "Pensiones": {
    "Mora": {
      "TasaDiaria": 0.001,
      "DiasGracia": 3,
      "TopePorcentaje": 0.10
    }
  },
  "RateLimiting": {
    "LoginPorMinuto": 10
  },
  "Cors": {
    "Origins": [ "http://localhost:5173", "http://localhost:8080" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
